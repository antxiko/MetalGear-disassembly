C 0x4253 apunta a la copia del banco de 0x6000
C 0x4256 el mapper: pone en 0x6000 el banco de A
C 0x425C el mapper: pone en 0x8000 el banco de A
C 0x4262 el mapper: pone en 0xA000 el banco de A
C 0x427D apunta a las banderas del juego (bit 6: se juega; en la demo no)
C 0x428F el mapper: pone en 0x6000 el banco de A
C 0x4292 guarda la copia del banco de 0x6000
C 0x4296 guarda la copia del banco de 0x8000
C 0x4299 el mapper: pone en 0x8000 el banco de A
C 0x429D pide_sonido: el sonido A (indice 0x6892): < 0x29 efecto en 0xC070 si manda mas, si no musica de 3 o 4 canales; 0x4D/0x59 guardan la musica
C 0x42A1 guarda la copia del banco de 0x6000 y el byte siguiente (16 bits)
C 0x42A5 el mapper: pone en 0x6000 el banco de A
C 0x42A9 el mapper: pone en 0x8000 el banco de A
C 0x42B1 lee la sala
C 0x42C9 apunta a los colores de las fichas
C 0x42D1 lee la sala
C 0x42D7 hl_mas_a: HL = HL + A
C 0x42E6 bancos_4_5_6: pone los bancos 4, 5 y 6 (y sus copias en 0xF0F1-0xF0F3)
C 0x42EB lee la sala
