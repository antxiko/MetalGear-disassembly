L 0x4198 vuelve_a_1_2_3 pone los bancos 1-2-3 y devuelve a 0xA000 el banco de 0xF0F6 si no es cero
L 0x41AC interrupcion H.TIMI: el sonido (banco 4, 0x6000) y, si no esta ya en marcha (0xC005), el juego del cuadro (0x6672)
L 0x41DE hl_mas_2a_menos_2 HL = HL + 2 x (A - 1)
L 0x41DF hl_mas_2a HL = HL + 2 x A
L 0x41E0 hl_mas_a HL = HL + A
L 0x41E5 de_mas_a DE = DE + A
L 0x41EA despacha salta a la palabra A de la tabla que va pegada detras del `call`
L 0x41F3 init el arranque: slot del cartucho en 0x8000, RAM 0xC000-0xF0EF a cero, bancos, H.TIMI y a esperar
L 0x4248 bancos_1_2_3 pone los bancos 1, 2 y 3 (y sus copias en 0xF0F1-0xF0F3)
L 0x424E bancos_4_5_6 pone los bancos 4, 5 y 6 (y sus copias en 0xF0F1-0xF0F3)
L 0x4252 bancos_desde_a pone A, A + 1 y A + 2 en 0x6000, 0x8000 y 0xA000 (y sus copias)
L 0x426A bancos_7_8_9 pone los bancos 7, 8 y 9 (y sus copias en 0xF0F1-0xF0F3)
L 0x4270 bancos_10_11_12 pone los bancos 10, 11 y 12 (y sus copias en 0xF0F1-0xF0F3)
L 0x4276 bancos_13_14_15 pone los bancos 13, 14 y 15 (y sus copias en 0xF0F1-0xF0F3)
L 0x427C sonido_si_hay pide el sonido A solo si se juega (bit 6 de 0xC002; en la demo no)
L 0x4284 sonido pide el sonido A al controlador del banco 4 (0x67FD) con los bancos 4 y 5
L 0x42B1 palabra_de_la_sala DE = la palabra de la tabla DE que toca a la sala (0xC130)
L 0x42B4 palabra_a DE = la palabra A de la tabla DE
L 0x42BD cuatro_a_menos_4 HL = 4 x (A - 1)
L 0x42BE cuatro_a HL = 4 x A
L 0x42C4 colores_por_defecto copia los 8 colores de 0x4B13 a 0xE700 (los de las fichas en 3 planos)
L 0x42C7 ocho_colores copia 8 colores de HL a 0xE700
L 0x42C9 c_colores copia C colores de HL a 0xE700
L 0x42D1 nibble_de_la_sala A = el nibble de la tabla HL que toca a la sala (0xC130)
L 0x42D4 nibble_a A = el nibble A de la tabla HL (el alto si A es par)
L 0x42E6 sala_vecina A = la sala vecina por el lado 0xC133 (tabla p05:8E0E); 0xFF si la sala no tiene vecinas
L 0x4315 parada_del_ascensor BC = los dos bytes que siguen a la parada 0xC136 en la lista del ascensor
L 0x432D datos_del_ascensor 0xC197 y 0xC198 = los dos primeros bytes del ascensor (sala - 0xF0) en p05:8DA8
L 0x4347 puertas_al_empezar 0xC450-0xC4EF: 0 si los bits 7-6 de p15:B046 son 10, 1 si no (160 puertas)
L 0x4362 byte_a204_de_la_sala 0xC158 = los 3 bits bajos de p12:A204[sala]
L 0x4376 nibble_a2ff_de_la_sala 0xC161 = el nibble de la sala en p12:A2FF
L 0x4384 tabla_de_dano apunta 0xEC00 a la tabla de dano del arma A (p05:87B7)
L 0x4396 dano A = el byte A de la tabla de dano de 0xEC00
L 0x43A3 byte_del_banco_5 A = el byte A - 1 de la tabla HL, con los bancos 4-5-6
L 0x43A9 suma_de_objeto A = el byte A de p05:8AE8 (lo que suma cada objeto)
L 0x43B4 caja_de_choque copia la caja A (p05:8A55 + 4 x (A - 1)) a 0xC928; HL = 0xC928
L 0x43E1 busca_objeto busca A en los 25 objetos de 0xC530 (fichas de 4): C = el sitio, Z si esta, acarreo si no
L 0x43E8 busca_arma busca A en las 7 armas de 0xC500 (fichas de 4): C = el sitio, Z si esta, acarreo si no
L 0x43FA carga_las_puertas copia las puertas de la sala (p15:A7C0) a 0xC3D0 con su estado (0xC450) y cuenta en 0xC4FF
L 0x44A7 dibujo_de_metal_gear pone el dibujo p15:B595 (Metal Gear) con L_44AF
L 0x44AC dibujo_b5f7 pone el dibujo p15:B5F7 con L_44AF
L 0x44AF pone_dibujo pone un dibujo del banco 15 ([filas][columnas] y fichas) en la sala, en D/E
L 0x44EC musica_de_la_sala 0xC602 a cero y elige la musica de la sala (0xC159, 0xC0F4) y 0xC15F
L 0x45EF dibujo_a_e600 copia un dibujo del banco 15 ([ancho][alto] en DE) a 0xE600
L 0x4613 gasta_municion resta 1 (BCD) a la cantidad de HL y la pinta; con C = 1 o mas, al acabarse quita el arma o el objeto
L 0x466A cuatro_ceros pone a cero 4 bytes desde HL
L 0x4673 colores_del_actor copia los colores del tipo (ix+0) (p05:975A) a la ficha, uno cada 5 bytes desde (ix+0x25)
L 0x4676 colores_del_tipo copia los colores del tipo A (p05:975A) a la ficha IX, uno cada 5 bytes desde (ix+0x25)
L 0x469C ventana_de_armas pinta la ventana de las armas que se llevan (0xC500): dibujo, nombre y municion
L 0x4751 marcador_arma pinta en el marcador el arma elegida (0xC134) y su municion
L 0x4795 pinta_municion el numero BCD de 2 bytes de HL en (0xC0, 0xC8)
L 0x479B borra_marcador_arma borra el hueco del arma en el marcador (0xA0C2, 0x38 x 0x10)
L 0x47A6 ventana_de_equipo pinta la ventana de los objetos que se llevan (0xC530): dibujo y nombre
L 0x4843 marcador_objeto pinta en el marcador el objeto elegido (0xC135)
L 0x488C borra_marcador_objeto borra el hueco del objeto en el marcador (0xE0C2, 0x18 x 0x10)
L 0x4892 rellena_pagina_0 rellena con D = 0 y A = 0
L 0x4897 pinta_cantidad la cantidad del objeto C en la ventana de equipo
L 0x48BD llamadas_de_la_sala carga las llamadas de radio de la sala (p15:B6C6) en 0xC880 (fichas de 0x1D) y cuantas en 0xC87F
L 0x4913 zona_banco_6 pone el banco 6 en 0xA000 y lo apunta en 0xF0F3 y 0xF0F6
L 0x4919 zona_banco_9 pone el banco 9 en 0xA000 y lo apunta en 0xF0F3 y 0xF0F6
L 0x491F zona_banco_12 pone el banco 12 en 0xA000 y lo apunta en 0xF0F3 y 0xF0F6
L 0x4925 zona_banco_15 pone el banco 15 en 0xA000 y lo apunta en 0xF0F3 y 0xF0F6
L 0x4935 juego_de_fichas carga el juego de fichas de la sala (nibble p07:6000) si no es el de 0xC157, y sus bits de choque en 0xC700
L 0x49A7 descriptor_de_fichas carga un descriptor de juego de fichas (IX, 5 bytes) con L_524C o L_5265
L 0x49DF sitio_de_ficha HL = 0x8000 + la direccion VRAM de la ficha A (8 x 8 en SCREEN 5)
L 0x49F4 fichas_de_las_puertas copia las fichas de las puertas (p07:61C9-6749) a la pagina 1
L 0x4A33 bloque_de_fichas copia C filas de B fichas de 32 bytes de HL a la VRAM DE (0x400 por fila)
L 0x4A44 sprites_de_la_sala carga los patrones del juego de sprites de la sala (p10:6185, p10:6280) en 0xF800
L 0x4A69 patrones_de_terna descomprime una terna [patron][origen] a 0xF800 + 8 x patron
L 0x4A92 paleta_del_juego manda al VDP la paleta p05:8B0B
L 0x4A9D paleta_de_snake manda al VDP los colores 7 y 10 (0x4AA3)
L 0x4AAA paleta_del_transceptor manda al VDP la paleta p05:8B1E
L 0x4AB5 paleta_de_sprites manda al VDP la paleta del juego de sprites de la sala (p05:8CB4)
L 0x4ACB paleta_de_la_sala manda al VDP la paleta de la sala (nibble p05:8B40, tabla p05:8BBE)
L 0x4B03 paleta_a manda al VDP la paleta A de la tabla p05:8BBE
L 0x4B33 fichas_del_marcador carga en la pagina 1 las fichas de los objetos, del marcador, de la camara y del retrato
L 0x4BB1 rotulo_b833 escribe el rotulo p06:B833
L 0x4BBC fichas_del_interruptor carga las fichas p15:B2BF en 0x9048 (VRAM)
L 0x4BCF fichas_de_las_cajas carga las fichas p09:9509 en 0x9400 y 0x9840 (VRAM)
L 0x4BEC patrones_del_arma carga los patrones del arma elegida (p10:6392) y los de su explosion
L 0x4C2E patrones_del_cohete carga los patrones del proyectil por la direccion (ix+0x0C) en 0xF880
L 0x4C4B graficos_del_logotipo_konami carga los tres bloques de 1 bit del logotipo de Konami (p09:B719, B781, B7E9) y pinta su montaje p09:B6D8
L 0x4C9A metafichas pone 8 metafichas de 4 x 4 de la lista HL en 0xEC00.. (filas de 32)
L 0x4CF0 monta_la_sala monta la sala (p13:6000) en 0xE000 y la pinta en la VRAM
L 0x4D3E lee_vram lee BC bytes de la VRAM HL a DE
L 0x4D51 cuenta_de_bloques B y A = los bloques de 256 de BC para otir/inir
L 0x4D59 escribe_vram copia BC bytes de HL a la VRAM DE
L 0x4D6C llena_vram llena BC bytes de la VRAM HL con A
L 0x4D85 byte_a_vram escribe A en la VRAM HL
L 0x4D93 vram_para_escribir pone la direccion de escritura de la VRAM en HL (R#14 y el puerto 1)
L 0x4DB2 vram_para_leer pone la direccion de lectura de la VRAM en HL (R#14 y el puerto 1)
L 0x4DCF patrones_con_destino lee la direccion VRAM de DE y descomprime detras
L 0x4DD5 patrones descomprime DE a la VRAM HL (n < 0x80 repite, n > 0x80 copia, 0x80 otro destino, 0 acaba)
L 0x4DF8 pantalla_limpia esconde los sprites, apaga la pantalla, borra la pagina 0 y la enciende
L 0x4E01 enciende_la_pantalla pone el bit 6 de R#1 y enciende los sprites (R#8)
L 0x4E0E apaga_la_pantalla quita el bit 6 de R#1 y apaga los sprites (R#8)
L 0x4E1B borra_la_pagina_0 llena la pagina 0 de color 0 y pone R#23 a cero
L 0x4E1D borra_la_pagina_d llena la pagina de D de color 0 y pone R#23 a cero
L 0x4E2C esconde_los_sprites llena de 0xE0 las dos tablas de atributos de la VRAM (0xF600 y 0xF200)
L 0x4E42 esconde_los_sprites_ram llena de 0xE0 la copia de los atributos (0xEA00-0xEA7F)
L 0x4E50 sprites_apagados pone el bit SPD de R#8
L 0x4E5B sprites_encendidos quita el bit SPD de R#8
L 0x4E66 color el color A de la paleta = DE ([RB][G]), y su copia en 0xF680
L 0x4E90 paleta_por_defecto manda al VDP los 16 colores de 0x4EA4
L 0x4EC4 paleta manda al VDP la lista de HL: [color][RB][G] ... 0xFF
L 0x4ED2 espera_al_vdp espera a que el VDP acabe el comando (S#2, bit CE)
L 0x4EDC estado_del_vdp A = el registro de estado A del VDP
L 0x4EFC linea_horizontal LINE de B puntos desde (H, L) en el color C
L 0x4F2F linea_vertical LINE de B puntos hacia abajo desde (H, L) en el color C
L 0x4F63 recuadro un recuadro de D x E desde (H, L) en el color C
L 0x4F7D linea_vertical_guarda linea_vertical guardando HL, DE y BC
L 0x4F87 linea_horizontal_guarda linea_horizontal guardando HL, DE y BC
L 0x4F91 rellena HMMV: llena B x C desde (H, L) de la pagina D con el byte A
L 0x4FCD copia_vram HMMM: copia B x C de (H, L) a (D, E); A = paginas (bits 0-1 origen, 2-3 destino)
L 0x5011 copia_logica LMMM: copia B x C de (H, L) a (D, E); A = [pagina origen 7-6][pagina destino 5-4][operacion 3-0]
L 0x505D caracteres_1_bit B caracteres de 1 bit de HL en el color C a la pagina 1 desde (D, E)
L 0x5066 caracter_1_bit un caracter de 1 bit de HL en el color C a la pagina 1 en (D, E)
L 0x5087 ficha_a_vram 8 lineas de 4 bytes de HL a la VRAM DE (lineas de 0x80)
L 0x509C fichas_a_vram B fichas de 32 bytes de HL a la VRAM DE, de 8 en 8 puntos y 8 lineas mas abajo cada 32
L 0x50B1 fichas_a_vram_espejo como fichas_a_vram, pero cada ficha volteada de lado
L 0x50E6 pasa_a_4_bits 8 bytes de 1 bit de HL a 4 bits por punto en 0xEC40, con el color C
L 0x510C rotulo escribe el rotulo de HL ([X][Y], caracteres, 0xFE otra posicion, 0xFF acaba)
L 0x5110 borra_rotulo lo mismo que rotulo, con el caracter en blanco
L 0x5116 rotulo_en_de escribe los caracteres de HL desde (D, E) (0xFE otra posicion, 0xFF acaba)
L 0x5135 caracter copia el caracter A de la pagina 1 a (D, E); con A = 0 o C = 0, el blanco
L 0x5157 ficha_a_pagina_0 copia la ficha A de la pagina 1 a (D, E) de la pagina 0
L 0x5169 ficha_transparente copia la ficha A de la pagina 1 a (D, E) con TIMP (de la segunda mitad si 0xC168 bit 0)
L 0x518A ficha_en_pagina_1 copia la ficha A de la pagina 1 a (D, E) de la pagina 1
L 0x519C ficha_del_bloque copia la ficha A del bloque de (0x38, 0x98) a (D, E) de la pagina 1
L 0x51AE sitio_en_pagina_1 H = 8 x (A mod 32), L = 8 x (A / 32): donde esta la ficha A en la pagina 1
L 0x51BC sitio_en_pagina_1_abajo lo mismo que sitio_en_pagina_1, 0x80 lineas mas abajo
L 0x51C4 sitio_en_el_bloque H/L de la ficha A dentro del bloque de (0x38, 0x98)
L 0x51D8 siguiente_sitio D = D + 8; si da la vuelta, E = E + 8
L 0x51E2 lista_de_fichas pinta la lista HL de fichas del bloque desde (D, E) (0xFE baja 8, 0xFF acaba)
L 0x51FE fichas_2_planos B fichas de 2 planos (16 bytes) de HL a la VRAM DE con los colores de 0xE700
L 0x5217 ficha_2_planos una ficha de 2 planos de HL a 4 bits en 0xE708
L 0x5221 fila_2_planos una fila (2 bytes) de una ficha de 2 planos a 4 bits en (HL')
L 0x524C fichas_3_planos B fichas de 3 planos (24 bytes) de HL a la VRAM DE con los colores de 0xE700
L 0x5265 fichas_3_planos_espejo como fichas_3_planos, pero cada ficha volteada de lado
L 0x527E ficha_3_planos una ficha de 3 planos de HL a 4 bits en 0xE708
L 0x5288 fila_3_planos una fila (3 bytes) de una ficha de 3 planos a 4 bits en (HL')
L 0x52BB empieza_texto 0xCEF3 = el texto 0xCEF0 (p12:A37D) y 0xCEF5 = su primer byte (el tipo de ventana)
L 0x52D7 trozo_de_texto copia el texto de 0xCEF3 a 0xCF10 con los trozos >= 0xA1 (p12:B8A7) puestos; A = 0 con 0xFF, 1 con 0xFD
L 0x5317 nada solo ret
L 0x5318 atributos_de_snake los sprites de la pose 0xC18A (p10:606A, p10:609F) a 0xEA00 (0xEA40 en las salas 0xF0+ salvo 0xFB) mas su Y y su X
L 0x535E colores_de_snake los colores de la pose 0xC18A, 16 lineas por sprite, a 0xE800 (0xE900 en las salas 0xF0+)
L 0x53A5 sprites_de_snake atributos, colores y patrones de la pose de Snake
L 0x53AB patrones_de_snake descomprime los patrones de la pose 0xC18A (p10:6000) en 0xF800
L 0x53DA atributos_del_proyectil el cuadro (ix+0x0B) de p10:63B0 a los sprites de IX sumando (ix+4) y (ix+6); 0x80 = escondido
L 0x5419 crea_tipo_35 la creacion del tipo 35
L 0x54AF cuadro_tipo_35 lo de cada cuadro del tipo 35
L 0x5506 atributos_del_actor el cuadro (ix+0x0B) de p05:9890 a los sprites de IX sumando su Y y su X (0x91-0xA5: grupo de 0x556F)
L 0x5599 sprites_de_los_actores pone los sprites de los 16 actores en la copia de atributos y sus colores
L 0x55AE sprites_de_un_actor los sprites del actor HL a 0xEA28 + 4 x n y sus colores a 0xE8A0 + 16 x n
L 0x55F0 actores_de_la_sala al entrar en sala: borra 0xD000-0xD7FF y crea los actores de la sala (p05:9560)
L 0x5675 esconde_sprites_de_actores llena de 0xE0 los atributos de los actores (0xEA28-0xEA7F)
L 0x5683 crea_lista_de_actores crea los actores de la lista ([cuantos] y [tipo][Y][X]) a la que apunta (HL + 1)
L 0x569A crea_actor crea un actor del tipo C en Y = E, X = D en la primera ficha libre de 0xD000; HL = la ficha, A = 0 si no cabe
L 0x56BE inicia_actor rellena la ficha HL: sprites (p05:971B), huecos en 0xEA28, colores, aguante (p05:984F) y la creacion de su tipo
L 0x57E2 nada_57e2 solo ret (la creacion del tipo 42)
L 0x57E3 crea_tipo_17 la creacion del tipo 17
L 0x57EC colores_de_tabla copia los colores del tipo (ix+0) de la tabla DE a la ficha, uno cada 5 bytes
L 0x580B apunta_hueco el sprite E del actor (0xEC04) usa el hueco D de 0xEA28
L 0x581B refuerzos con 0xC602 puesto, cada 0xC605 cuadros crea un actor de p06:A445 (sala x 3) si hay pocos de ese tipo
L 0x5877 mira_c602 quita 0xC602 (y lo que sigue) segun la sala, la cuenta 0xC605 y los actores que quedan
L 0x58E4 reaparece_ya 0xC605 = 1 y crea en IX el actor de p06:A445 de la sala
L 0x58E9 reaparece crea en IX el actor de p06:A445 de la sala (salas < 0xBC)
L 0x58FD pon_tipo pone el tipo A en IX y lo prepara (p03:B3F8, p02:8334, p03:A923, colores)
L 0x5927 tres_a HL = 3 x A
L 0x5935 crea_tipo_30 la creacion del tipo 30
L 0x5939 crea_tipo_5 la creacion del tipo 5
L 0x593D crea_tipo_4 la creacion del tipo 4
L 0x596B elige_camino elige un camino de la sala para IX (por los actores que hay) y lo carga
L 0x5997 camino_b el camino B de la sala (p06:A2DF) para IX, con los arreglos de algunas salas (p03:A10C-A17B)
L 0x59CC carga_camino carga el camino B de la sala (p06:A2DF) en IX y va al primer punto
L 0x5A02 hacia_el_punto direccion (ix+0x11) y velocidades hacia el punto (ix+0x15, ix+0x16) con la marcha (ix+0x43)
L 0x5A6A punto_alcanzado pone el actor en el punto, pasa al siguiente del camino y, a veces, se para
L 0x5AE9 sigue_si_punto_1 si (ix+0x14) no es 1 vuelve; si es 1, sale tambien de quien llamo
L 0x5B01 camino_al_azar elige un camino al azar de la sala (p06:A2DF) para IX
L 0x5B45 sitio_de_snake E = la Y de Snake, D = la X
L 0x5B4E velocidad_y la velocidad Y del actor (ix+7, ix+8) = DE
L 0x5B55 suma_velocidad_x la velocidad X del actor (ix+9, ix+0x0A) += DE
L 0x5B5D velocidad_x la velocidad X del actor (ix+9, ix+0x0A) = DE
L 0x5B64 velocidades la velocidad X del actor = DE y la Y = HL
L 0x5B6A alterna_cuadro si (ix+0x0C) AND B es 0, cambia el bit 0 del cuadro
L 0x5B78 cuadro_de_paso si (ix+0x0C) AND B es 0, cuadro = 3 x direccion + paso (0x5B9E) + C
L 0x5BA2 paso_siguiente sube el paso del actor (ix+1)
L 0x5BA6 paso_cero el paso del actor (ix+1) a cero
L 0x5BAB paso_a el paso del actor (ix+1) = A
L 0x5BAF cuenta_tipo A = cuantos actores del tipo A hay
L 0x5BC1 colores_a_cero escribe A y C alternos cada 5 bytes desde (ix+0x25)
L 0x5BDF pareja_del_angulo C y B = los bytes (ix+0x14) y 63 - (ix+0x14) de la tabla p06:A6B9
L 0x5BE2 pareja_a C y B = los bytes A y 63 - A (A de 0 a 63) de la tabla p06:A6B9
L 0x5BFB de_negado DE = -DE
L 0x5C01 hl_negado HL = -HL
L 0x5C09 ficha_en_el_punto HL = 0xE000 + (L / 8) x 32 + H / 8: la ficha de la sala montada en ese punto
L 0x5C25 hacia_snake HL y DE = la velocidad de IX hacia Snake con el modulo 0x80 (+ 8 x 0xC152)
L 0x5C27 hacia_snake_a HL y DE = la velocidad de IX hacia Snake con el modulo A (+ 8 x 0xC152)
L 0x5C7A angulo_a_snake 0xEC86 = el angulo de (E, D) a Snake (p06:A679) y los signos en 0xEC81/0xEC82
L 0x5CBB escala DE = E x (0xEC80) / 32
L 0x5CCD multiplica HL = H x E
L 0x5CD9 ventana_de_texto_2 abre la ventana del texto A en el modo 2 (0xCEE0)
L 0x5CDD ventana_de_texto_1 abre la ventana del texto A en el modo 1 (0xCEE0)
L 0x5CE1 ventana_de_texto abre la ventana del texto A en el modo 0: 0xCEF0 = A, guarda 0xC151 en 0xCEF1 y pone 0xC151 = 10
L 0x5D03 ventana_paso un paso de la ventana de texto (0xCEF2, tabla 0x5D1D)
L 0x5D29 ventana_prepara paso 0: tipo de ventana (0xCEF5), marco, recuadro y el fondo guardado en la pagina 1
L 0x5D7E ventana_paso_siguiente sube el paso de la ventana de texto 0xCEF2
L 0x5D83 ventana_abre paso 1: espera a p02:8240 y salta al paso 4
L 0x5D99 ventana_escribe paso 2: escribe una letra cada 4 (u 8) cuadros con el sonido 0x23
L 0x5E28 retrato_b41f pone el retrato p15:B41F en la ventana (modo 4)
L 0x5E6B ventana_espera paso 3: espera la tecla o la cuenta 0xCEFB y borra el recuadro
L 0x5EC1 ventana_siguiente paso 4: el trozo siguiente del texto a 0xCF10 (trozo_de_texto)
L 0x5EE9 ventana_cierra paso 5: devuelve el fondo, 0xC151, y marca 0xC661/0xC663/0xC662 con los textos 0x75/0x76/0x8A
L 0x5F13 ventana_vuelve devuelve el modo 0xCEF1 a 0xC151 y marca 0xC661/0xC663/0xC662 con los textos 0x75/0x76/0x8A
L 0x5F38 recuadro_de_ventana E D C B = el recuadro del tipo de ventana (0x5F92)
L 0x5F44 cuatro_bytes E, D, C y B = los 4 bytes de HL
L 0x5FA6 snake_al_empezar Snake al empezar: paleta, pose, direccion, y con 0xC002 bit 6 la pose 0x25 en (0xB8, 0xC0)
L 0x5FFB estado_de_snake despacha por el estado de Snake (0xC180, tabla en p01:6001)
C 0x4050 hl_mas_a: HL = HL + A
C 0x4055 de_mas_a: DE = DE + A
C 0x405A sonido_si_hay: pide el sonido A solo si se juega (bit 6 de 0xC002; en la demo no)
C 0x405F ventana_de_texto: abre la ventana del texto A en el modo 0: 0xCEF0 = A, guarda 0xC151 en 0xCEF1 y pone 0xC151 = 10
C 0x4064 velocidad_de_snake: 0xC185 y la velocidad de Snake (0xC186 Y, 0xC188 X) con el modulo 0xC143
C 0x4069 velocidad_arriba_abajo: la velocidad de Snake (0xC186/0xC188) si se pulsa arriba o abajo
C 0x406E choque_de_snake: mira con p02:8298 el sitio al que va Snake y la para si choca
C 0x4073 mueve_snake: suma las velocidades a Snake y mira los cuatro bordes (0xC133 y el modo 1)
C 0x4078 pose_de_snake: elige la pose 0xC18A por el modo 0xC18B (tabla 0x6508)
C 0x407D transceptor_abre: paso 0: la pantalla del transceptor (marco p15:B369, retrato p15:B40D, rotulo, frecuencia)
C 0x4082 transceptor_senal: paso 2: sube la barra de senal 0xC801 hasta 12
C 0x4087 sale_del_transceptor: paleta de Snake y vuelve a la sala
C 0x408C caracteres_1_bit: B caracteres de 1 bit de HL en el color C a la pagina 1 desde (D, E)
C 0x4091 fichas_2_planos: B fichas de 2 planos (16 bytes) de HL a la VRAM DE con los colores de 0xE700
C 0x4096 rellena: HMMV: llena B x C desde (H, L) de la pagina D con el byte A
C 0x409B pantalla_limpia: esconde los sprites, apaga la pantalla, borra la pagina 0 y la enciende
C 0x40A0 apaga_la_pantalla: quita el bit 6 de R#1 y apaga los sprites (R#8)
C 0x40A5 copia_logica: LMMM: copia B x C de (H, L) a (D, E); A = [pagina origen 7-6][pagina destino 5-4][operacion 3-0]
C 0x40AA enciende_la_pantalla: pone el bit 6 de R#1 y enciende los sprites (R#8)
C 0x40AF rotulo: escribe el rotulo de HL ([X][Y], caracteres, 0xFE otra posicion, 0xFF acaba)
C 0x40B4 ficha_en_pagina_1: copia la ficha A de la pagina 1 a (D, E) de la pagina 1
C 0x40BE palabra_a: DE = la palabra A de la tabla DE
C 0x40C3 vram_para_escribir: pone la direccion de escritura de la VRAM en HL (R#14 y el puerto 1)
C 0x40C8 escribe_vram: copia BC bytes de HL a la VRAM DE
C 0x40CD color: el color A de la paleta = DE ([RB][G]), y su copia en 0xF680
C 0x40D2 busca_objeto: busca A en los 25 objetos de 0xC530 (fichas de 4): C = el sitio, Z si esta, acarreo si no
C 0x40D7 sube_c132: sube 0xC132 hasta 3 con el sonido 0x26
C 0x40DC borra_rotulo: lo mismo que rotulo, con el caracter en blanco
C 0x40E1 musica_de_nuevo: 0xC159 = 0 y elige la musica de la sala
C 0x40E6 caracter: copia el caracter A de la pagina 1 a (D, E); con A = 0 o C = 0, el blanco
C 0x40EB esconde_los_sprites: llena de 0xE0 las dos tablas de atributos de la VRAM (0xF600 y 0xF200)
C 0x40F0 dibujo_de_metal_gear: pone el dibujo p15:B595 (Metal Gear) con L_44AF
C 0x40F5 borra_la_pagina_0: llena la pagina 0 de color 0 y pone R#23 a cero
C 0x40FA juego_de_fichas: carga el juego de fichas de la sala (nibble p07:6000) si no es el de 0xC157, y sus bits de choque en 0xC700
C 0x40FF paleta_de_la_sala: manda al VDP la paleta de la sala (nibble p05:8B40, tabla p05:8BBE)
C 0x4104 pone_dibujo: pone un dibujo del banco 15 ([filas][columnas] y fichas) en la sala, en D/E
C 0x4109 dibujo_b5f7: pone el dibujo p15:B5F7 con L_44AF
C 0x410E teclas_del_juego: 0xC007 = las teclas que hay, 0xC006 = las nuevas
C 0x4113 paleta_por_defecto: manda al VDP los 16 colores de 0x4EA4
C 0x4118 paleta: manda al VDP la lista de HL: [color][RB][G] ... 0xFF
C 0x411D graficos_del_logotipo_konami: carga los tres bloques de 1 bit del logotipo de Konami (p09:B719, B781, B7E9) y pinta su montaje p09:B6D8
C 0x4122 copia_vram: HMMM: copia B x C de (H, L) a (D, E); A = paginas (bits 0-1 origen, 2-3 destino)
C 0x4127 ventana_de_texto_2: abre la ventana del texto A en el modo 2 (0xCEE0)
C 0x4131 linea_vertical: LINE de B puntos hacia abajo desde (H, L) en el color C
C 0x4136 linea_horizontal: LINE de B puntos desde (H, L) en el color C
C 0x4140 sonido: pide el sonido A al controlador del banco 4 (0x67FD) con los bancos 4 y 5
C 0x4145 paleta_a: manda al VDP la paleta A de la tabla p05:8BBE
C 0x414A ventana_paso: un paso de la ventana de texto (0xCEF2, tabla 0x5D1D)
C 0x4163 borra_la_pagina_d: llena la pagina de D de color 0 y pone R#23 a cero
C 0x4168 fichas_3_planos: B fichas de 3 planos (24 bytes) de HL a la VRAM DE con los colores de 0xE700
C 0x416D paleta_del_juego: manda al VDP la paleta p05:8B0B
C 0x4172 fichas_del_marcador: carga en la pagina 1 las fichas de los objetos, del marcador, de la camara y del retrato
C 0x4177 guarda_paleta: lee la paleta de 0xF680 (VRAM) a 0xC1CF en formato [color][RB][G]
C 0x417C funde_paleta: apaga un poco la paleta de 0xC1CF y la manda; acarreo cuando todo es 0
C 0x4186 atributos_de_snake: los sprites de la pose 0xC18A (p10:606A, p10:609F) a 0xEA00 (0xEA40 en las salas 0xF0+ salvo 0xFB) mas su Y y su X
C 0x418B patrones_de_snake: descomprime los patrones de la pose 0xC18A (p10:6000) en 0xF800
C 0x4190 esconde_los_sprites_ram: llena de 0xE0 la copia de los atributos (0xEA00-0xEA7F)
C 0x4198 bancos_1_2_3: pone los bancos 1, 2 y 3 (y sus copias en 0xF0F1-0xF0F3)
C 0x419C lee el banco de zona de 0xA000
C 0x41A3 el mapper: pone en 0xA000 el banco de A
C 0x41A6 guarda la copia del banco de 0xA000
C 0x41B2 el mapper: pone en 0x6000 el banco de A
C 0x41B6 el mapper: pone en 0x8000 el banco de A
C 0x41B9 sonido_del_cuadro: el controlador de sonido, cada interrupcion: mezclador, modo 0xC0F1, fundido 0xC0F4 y los 4 canales
C 0x41BC lee la copia del banco de 0x6000
