C 0x4F1A R#40-41: NX = B - 1 (el lado largo)
C 0x4F20 R#42-43: NY = 0
C 0x4F25 R#44: el color C
C 0x4F27 R#45 = 0: el lado largo en X
C 0x4F29 R#46 = 0x70: LINE
C 0x4F33 el puerto de registros del VDP
C 0x4F38 R#17 = 36 (0x24): escritura seguida desde R#36
C 0x4F41 el puerto de registros indirectos
C 0x4F43 R#36-37: DX = H
C 0x4F48 R#38-39: DY = L (pagina 0)
C 0x4F4C H = B, L = C
C 0x4F4D R#40-41: NX = B - 1 (el lado largo)
C 0x4F53 R#42-43: NY = 0
C 0x4F58 R#44: el color C
C 0x4F5A R#45 = 1 (MAJ): el lado largo en Y
C 0x4F5D R#46 = 0x70: LINE
C 0x4F63 el lado izquierdo, E de alto
C 0x4F67 el de arriba, D de ancho
C 0x4F6C el de abajo: L + E - 1
C 0x4F75 el derecho: H + D - 1
C 0x4F91 A' = el byte de relleno
C 0x4F96 el puerto de registros del VDP
C 0x4F9B R#17 = 36 (0x24): escritura seguida desde R#36
C 0x4FA4 el puerto de registros indirectos
C 0x4FA6 R#36-37: DX = H
