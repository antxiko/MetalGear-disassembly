C 0x9E72 oye_disparo: acarreo si el actor esta marcado o hay un disparo sin SILENCER en marcha
C 0x9E75 alarma_de_actor: la alarma desde el actor: 0xC614 por la sala (0x98DE), 0xC60C y los refuerzos
C 0x9E8B sube si el actor se mueve (p01:7336)
C 0x9E96 ventana_de_texto_2: abre la ventana del texto A en el modo 2 (0xCEE0)
C 0x9E99 lee la sala
C 0x9EA7 con que choca el actor (bit 0 Snake, bit 1 proyectiles) = 0x00
C 0x9EB1 cuenta_tipo: A = cuantos actores del tipo A hay
C 0x9EB4 guarda el numero del actor entre los de su tipo
C 0x9EB9 guarda la cuenta de espera del actor
C 0x9EBC lee la sala
C 0x9ECB hl_mas_2a: HL = HL + 2 x A
C 0x9ED2 lee el numero del actor entre los de su tipo
C 0x9ED6 hl_mas_a: HL = HL + A
C 0x9EDF guarda el cuadro del actor
C 0x9EE2 sube si el actor se mueve (p01:7336)
C 0x9EE5 lee el numero del actor entre los de su tipo
C 0x9EE8 carga_camino: carga el camino B de la sala (p06:A2DF) en IX y va al primer punto
C 0x9F19 lee el paso del actor
C 0x9F1C despacha: salta a la palabra A de la tabla que va pegada detras del `call`
C 0x9F25 lee la bandera 0xC602 (refuerzos y musica)
C 0x9F33 hl_mas_2a: HL = HL + 2 x A
C 0x9F36 lee la Y del actor
C 0x9F3C lee la X del actor
C 0x9F43 ve_a_snake_desde: mira hacia A desde HL: Snake en linea y sin pared por medio (no en la caja quieta)
C 0x9F4C si el actor se mueve (p01:7336) = 0x00
C 0x9F50 la cuenta de espera del actor = 0x20
C 0x9F54 paso_siguiente: sube el paso del actor (ix+1)
C 0x9F57 lee si el actor se mueve (p01:7336)
C 0x9F5B llego_al_punto: si paso el punto (ix+0x15, 0x16) por su direccion, punto_alcanzado
C 0x9F5E baja la cuenta de espera del actor
C 0x9F62 si el actor se mueve (p01:7336) = 0x01
C 0x9F68 guarda la cuenta de espera del actor
C 0x9F6B hacia_el_punto: direccion (ix+0x11) y velocidades hacia el punto (ix+0x15, ix+0x16) con la marcha (ix+0x43)
C 0x9F6E baja la cuenta de espera del actor
C 0x9F74 lee la cuenta de espera del actor
C 0x9F8E lee el paso del actor
C 0x9F91 despacha: salta a la palabra A de la tabla que va pegada detras del `call`
C 0x9F9A llego_al_punto: si paso el punto (ix+0x15, 0x16) por su direccion, punto_alcanzado
C 0x9F9D lee la Y de Snake
C 0x9FA0 compara con la Y del actor
C 0x9FA4 lee la X de Snake
C 0x9FA9 lee la X del actor
C 0x9FB2 lee el paso del actor
C 0x9FB6 paso_siguiente: sube el paso del actor (ix+1)
C 0x9FC0 velocidad_x: la velocidad X del actor (ix+9, ix+0x0A) = DE
C 0x9FC3 lee la X del actor
C 0x9FC6 lee la Y del actor
C 0x9FCD crea_actor: crea un actor del tipo C en Y = E, X = D en la primera ficha libre de 0xD000; HL = la ficha, A = 0 si no cabe
C 0x9FD5 llego_al_punto: si paso el punto (ix+0x15, 0x16) por su direccion, punto_alcanzado
C 0x9FE2 bajo_la_camara: si Snake pasa por debajo: paso 1 y crea el tipo 0x36; A = 0xFF
C 0x9FE7 lee la X de Snake
C 0x9FEA le resta la X del actor
C 0x9FFB camino_del_actor: carga el camino (ix+0x0F) de la sala
# --- fin de las anotaciones de anota.py ---
