# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x6013 snake_estado_0 estado 0: teclas, salas especiales, golpe, velocidad, choque, pose y bordes
L 0x605B snake_estado_1 estado 1: teclas de lado y la cuenta 0xC190 (vuelve al 0)
L 0x6061 snake_estado_3 estado 3: solo la pose
L 0x6064 snake_estado_2 estado 2: el ascensor (0xC197/0xC198), velocidad, choque y el borde de lado
L 0x6082 snake_estado_4 estado 4: velocidad Y fija de 1 y la X de 0xC003 (bit 4), pose 3
L 0x609C snake_estado_5 estado 5: sube 3 puntos por cuadro hasta Y = 0x30, y vuelve al 0
L 0x60AD snake_estado_6 estado 6: teclas de lado, velocidad, choque y la ficha 8 con arriba
L 0x60C6 snake_estado_7 estado 7: teclas de arriba/abajo en la sala 0xE0
L 0x60E3 snake_estado_8 estado 8: p09:AE8F y, al volver al 0, p06:BDF8
L 0x60FA teclas_arriba_abajo 0xC18C = la direccion de las teclas de arriba/abajo (mascara 3)
L 0x60FE teclas_de_lado 0xC18C = la direccion de las teclas de lado (mascara 0x0C)
L 0x6102 teclas_de_direccion 0xC18C = la direccion de las teclas (1 arriba, 2 abajo, 3 izquierda, 4 derecha; 0x6150)
L 0x6104 teclas_con_mascara 0xC18C = la direccion de las teclas de la mascara C, la ultima pulsada manda
L 0x6160 velocidad_arriba_abajo la velocidad de Snake (0xC186/0xC188) si se pulsa arriba o abajo
L 0x616D velocidad_de_lado la velocidad de Snake (0xC186/0xC188) si se pulsa izquierda o derecha
L 0x617A velocidad_de_snake 0xC185 y la velocidad de Snake (0xC186 Y, 0xC188 X) con el modulo 0xC143
L 0x61DC golpe con la tecla 0x20 nueva: estado 1, pose 1, 0xC190 = 8 y Snake quieta
L 0x61FB snake_quieta la velocidad de Snake a cero (0xC186 y 0xC188)
L 0x6205 choque_de_snake mira con p02:8298 el sitio al que va Snake y la para si choca
L 0x623A golpe_contra_pared mira con p02:8298 dos puntos por delante y, si hay pared, el sonido 9
L 0x626C cuenta_del_golpe baja 0xC190 y al llegar a cero vuelve al estado 0
L 0x6279 teclas_del_ascensor con X < 0x78 y arriba/abajo pulsadas, si el ascensor va a otra parada: 0xC195 y el modo 6
L 0x62BB pose_por_la_ficha en las salas de 0x6342 elige el modo de pose 0xC18B por la ficha que pisa Snake
L 0x634C sala_35 en la sala 0x35, con el objeto no 2 y Snake en el recuadro: abajo pone 0xC1A0, si no estado 5
L 0x6385 sube_por_la_ficha_8 sobre la ficha 8 con arriba nueva: Y = 0x99, estado 7 y pose 5
L 0x63B8 baja_en_la_sala_e0 en la sala 0xE0 con Y = 0x99 y un lado: Y = 0x9E, estado 6
L 0x63FC mueve_snake suma las velocidades a Snake y mira los cuatro bordes (0xC133 y el modo 1)
L 0x641D mueve_snake_x suma la velocidad X (no baja de 0x68) y mira el borde derecho
L 0x6434 mueve_snake_y suma la velocidad Y y mira los bordes de arriba/abajo (con los casos de 0xE0 y 0xE2)
L 0x6461 sale_por_el_lado 0xC133 = C y el modo de la partida 0xC151 = 1 (cambio de sala)
L 0x6471 suma_velocidad_x_snake la X de Snake += 0xC188
L 0x647D suma_velocidad_y_snake la Y de Snake += 0xC186
L 0x6489 baja_c132 borra 0xC640-0xC651 (salvo 0xC64D) y, si 0xC132 > 0, lo baja con el sonido 0x27
L 0x64C8 sube_c132_cada_5 sube 0xC13A y, cada 5, sube 0xC132
L 0x64D2 sube_c132 sube 0xC132 hasta 3 con el sonido 0x26
L 0x64DF maximo_c137 0xC137 = 0x20, 0x28, 0x30 o 0x18 segun 0xC132 (1, 2, 3, 0) y lo pinta
L 0x6502 pose_de_snake elige la pose 0xC18A por el modo 0xC18B (tabla 0x6508)
L 0x6518 pose_modo_0 andando: la pose por la direccion, el paso (0xC18F) y si lleva arma
L 0x6561 pose_modo_1 pose 0x18 + direccion - 1
L 0x656A pose_modo_2 pose 0x1C (0x20 con arma) + direccion - 1, + 0x11 con el bit 3 de 0xC003
L 0x6589 pose_modo_3 pose 0x24
L 0x658E pose_modo_4 pose 0x25/0x26 alternas cada 4 cuadros
L 0x65A5 pose_modo_5 pose 0x27/0x28 alternas cada 6 cuadros andando
L 0x65CA pose_modo_6 pose por 0xC19D (0x2B, 0x29 o la de la cuenta)
L 0x65E4 pose_modo_7 pose 0x2A, o 0x2C con el bit 3 de 0xC003 andando
L 0x65F7 pon_pose 0xC18A = A
L 0x65FB sprite_de_la_grenade con la GRENADE (arma 3): el sprite 0xEA24 (patron 0x18, color 14) delante de Snake (0x666A), o escondido
L 0x6672 juego_del_cuadro sube 0xC003 y despacha por el estado del juego 0xC000 (tabla 0x6686)
L 0x6698 juego_estado_0 estado 0: los pasos 0xC001 del banco 9 (p09:B6B6, B4DA, B506, B670)
L 0x66ED teclas_f_y_f0f7 lee las teclas de funcion en 0xF0F9 y, con la 0x10 nueva, cambia 0xF0F7
L 0x6701 juego_estado_1 estado 1: espera 0xC004 cuadros y al estado siguiente
L 0x670C juego_estado_2 estado 2: p06:BCAE y luego p06:BD6D/BD3F hasta 0xC123 = 0
L 0x671F al_estado_0 estado 0 con 0x20 cuadros de espera
L 0x6720 al_estado_a estado A con 0x20 cuadros de espera y el paso 0
L 0x6740 juego_estado_3 estado 3: el rotulo p02:9282 parpadeando, luego p02:8FB0
L 0x675E juego_estado_4 estado 4: pantalla limpia, la partida desde el principio (L_6D6F), 0xC123 = 1
L 0x6769 al_estado_siguiente al estado siguiente con 0x20 cuadros de espera
L 0x6777 juego_estado_5 estado 5: la partida (L_6F18); 0xC008 = 1 la pausa
L 0x67B3 rotulo_pause guarda el fondo y escribe PAUSE (0x5C1D)
L 0x67D0 juego_estado_6 estado 6: espera que acabe la musica (0xC012) o la tecla
L 0x67F1 borra_game_over con F5 borra el rotulo 0x92A0 y pone 0xC125 = 1
L 0x6819 juego_estado_7 estado 7: la pausa: F1 sigue (y mira las claves tecleadas), F4 carga y F5 graba en cinta (0xC6A0)
L 0x6897 juego_estado_8 estado 8: p15:B8BC, BD92 y B8DE hasta 0xC922 = 0x0E
L 0x68BF teclas_del_titulo en los estados 0-2: con la tecla 0x10/0x20 empieza la partida (0xC002 = 0x40, estado 3)
L 0x68FA modo_4 modo 4: el transceptor (pasos 0xC153, tabla 0x6908)
L 0x6912 transceptor_abre paso 0: la pantalla del transceptor (marco p15:B369, retrato p15:B40D, rotulo, frecuencia)
L 0x695E transceptor_espera paso 1: RECV; con arriba nueva, SEND y el texto 10; si no, cambia la frecuencia y busca llamada
L 0x699F transceptor_senal paso 2: sube la barra de senal 0xC801 hasta 12
L 0x69B3 siguiente_paso_c153 sube 0xC153
L 0x69B8 transceptor_texto paso 3: el texto de la llamada ((0xC803) + 3) con el sonido 0x5C
L 0x69CC transceptor_vuelve paso 4: vuelve al paso 1 con la barra a cero
L 0x69F7 cambia_rotulo borra el rotulo DE y escribe el HL
L 0x6A02 cambia_frecuencia con izquierda/derecha sube o baja la frecuencia 0xC138 (BCD, 00-99)
L 0x6A41 busca_llamada busca en 0xC880 una llamada con la frecuencia 0xC138 que se oiga; paso 2
L 0x6A88 llamada_callada acarreo si la llamada de HL no se oye ahora (casos 0x85, 0x13, 0x79, 0x26, 0x48 y 0x0F)
L 0x6B04 digitos_de_frecuencia los dos digitos de 0xC138 en (0x98, 0x21), dos caracteres cada uno (0x6B34)
L 0x6B16 digito_de_frecuencia el digito A (dos caracteres de 0x6B34) en (D, E)
L 0x6B56 barra_de_senal la barra de senal 0xC801 (0-12) desde (0x40, 0x20)
L 0x6B8D tramos_de_barra B tramos de la ficha HL de la pagina 1 en (D, E) y (D, E + 8)
L 0x6BB1 sale_del_transceptor paleta de Snake y vuelve a la sala
L 0x6BBC modo_2 modo 2: la ventana de las armas
L 0x6C6D cierra_ventana vuelve a la sala: monta la sala, paletas, puertas, objetos y jefes, y la enciende
L 0x6CD9 hueco_del_arma 0xC154 = el hueco de 0xC500 del arma elegida (1 si no esta)
L 0x6CE1 busca_hueco_c C = el hueco de la lista DE (de 4 en 4) donde esta (HL)
L 0x6D04 borra_marca el caracter 0 en 0xC155
L 0x6D08 pon_marca el caracter 0x3C en 0xC155
L 0x6D11 guarda_paleta lee la paleta de 0xF680 (VRAM) a 0xC1CF en formato [color][RB][G]
L 0x6D2E funde_paleta apaga un poco la paleta de 0xC1CF y la manda; acarreo cuando todo es 0
L 0x6D48 apaga_un_poco cada 4 cuadros baja en 1 cada componente de la paleta de 0xC1D0
L 0x6D6F empieza_la_partida la partida desde el principio: puertas, objeto 6, sala 0x79 (si se juega), frecuencia 120.85, Snake
L 0x6DD9 musica_de_nuevo 0xC159 = 0 y elige la musica de la sala
L 0x6DEB modo_1 modo 1: cambio de sala
L 0x6F18 partida un cuadro de partida: Snake, actores y el modo 0xC151 (tabla 0x6F7A)
L 0x6F94 modo_0 modo 0, el juego: teclas de funcion, Snake, actores y proyectiles
L 0x7024 modo_5 modo 5: p09:BF66
L 0x702F modo_6 modo 6: p02:9209, p09:AD69 y los sprites de Snake
L 0x7046 modo_7 modo 7: L_7A84
L 0x704B modo_8 modo 8: la sala vecina (L_710D); con la tecla de funcion 4 vuelve
L 0x7060 modo_9 modo 9: baja 0xC19D y mueve a Snake; al acabar 0xC123 = 0
L 0x7070 modo_10 modo 10: la ventana de texto (con el texto 0x96, hasta 3 veces 0xC623)
L 0x7086 modo_11 modo 11: la secuencia 0xC900 y los actores
L 0x708E modo_12 modo 12: p09:BFD1
L 0x70AB colores_a_vram_15 colores_a_vram con el banco 15
L 0x70C4 vuelve_de_la_vecina devuelve los actores de 0xD800 y lo guardado, y al modo C
L 0x70F0 al_modo_c el modo de la partida 0xC151 = C (salas < 0xF0); con el 4, el sonido 0x59
L 0x710D mira_la_vecina con una tecla de direccion pone en 0xC130 la sala vecina; 0xC19C cuadros despues vuelve
L 0x7164 monta_la_vecina monta la sala 0xC130 con sus actores
L 0x71DF actores_del_cuadro lo de 0xC669, los refuerzos y un cuadro de cada uno de los 16 actores
L 0x7211 fin_de_actores solo ret: fin del bucle de actores y lo de cada cuadro de los tipos 2, 7, 17, 42 y 56
L 0x7212 un_actor sube (ix+0x0C) y despacha: sin aguante muere, con el bit 7 del tipo muriendo, si no su tipo (tabla 0x722F)
L 0x72B1 cuenta_c669 al acabar 0xC669, en la sala 0xC60F y con 0xC668 a cero copia 16 x 16 de (0x60, 0x80) de la pagina 1 a 0xC60C
L 0x72DB sacude_actor con (ix+0x1F) 0x3F/0x3D sube la Y 4 puntos, con 0x3B/0x39 la baja
L 0x72F9 actor_golpeado sube (ix+0x7A): al tercero muere (y a veces suelta algo); si no, (ix+0x1F) = 0x40
L 0x7336 mueve_actor suma las velocidades a la Y y a la X (16 bits) si (ix+6) no es cero
L 0x7360 actor_fuera si el actor sale de la sala (Y >= 0xC1, X >= 0xFF o < 7) lo quita
L 0x737B quita_actor quita al actor: banderas por tipo (0xA0, 0x9A, 0xA9, 0xA4, 0xA1, 0xA2, 0xB9, 0x12, 0x2C), objeto y musica
L 0x740C borra_actor el tipo y (ix+0x0E) a cero y sus sprites escondidos
L 0x7434 pon_objeto p06:BB8E con A = C y DE (Y, X)
L 0x7443 tapa_tipo_7 copia 16 x 16 de (p03:AF8C, 0xA0) de la pagina 1 a la Y/X del actor
L 0x7458 atributos_de_los_actores los atributos del cuadro de los 16 actores
L 0x746F muere_actor baja 0xC606 (tipos 10, 11, 13, 20-22), tapa el 7 y marca el tipo con el bit 7 (salvo 0x40), sonido 0x16
L 0x74B1 muriendo despacha por el nibble del tipo (0x74D0, tabla 0x74C0)
L 0x74F1 muriendo_3 en la sala 0xC1 con (ix+0x0F) = 3 pone 0xC657 y 0xC64D; y muriendo_2
L 0x7507 muriendo_2 si (ix+0x0C) es 0, baja_c132; y muriendo_1
L 0x7512 muriendo_1 con el tipo 0x20, 0xC4BA = 0; y lo quita
L 0x7521 muriendo_4 explosion de 6 sprites (cuadros 0x7A-0x7C) y la quita al cuadro 0x10
L 0x753C muriendo_5 explosion de 2 sprites (cuadros 0x6A-0x6C) y la quita al cuadro 0x10
L 0x7562 muriendo_6 la bandera (ix+0x1B), y explosion de 18 u 8 sprites (cuadros 0x7F-0x81); Metal Gear (0x11) aparte
L 0x75BB cuadro_y_colores (ix+0x0B) = C y los colores de HL, uno cada 5 bytes desde (ix+0x25), B sprites
L 0x75E2 muriendo_metal_gear el tipo 0x11: el color 15 parpadea, cuadros 0x89-0x8E y al final el texto 0x96
L 0x767B metal_gear_roto p12:BC36
L 0x7684 muriendo_7 tipos 9 y 0x12 se quitan, 0x26 p03:B8C6, 0x11 p12:BC36, 0x2C deja dos fichas en 0xC63B
L 0x76BC fichas_de_c63b pinta las dos fichas de 0x7703 (0x7705 en la sala 0x28) en 0xC63B
L 0x76D7 fichas_de_c63b_si_hay fichas_de_c63b si 0xC63B y no 0xC616
L 0x7707 llama_bf6e p15:BF6E
L 0x7710 pinta_las_puertas pinta cerradas las puertas de la sala cuyo byte 1 no es cero, por su tipo (tabla 0x773C)
L 0x7738 pinta_puerta pinta la puerta del tipo A en 0xEC00
L 0x7762 puerta_tipo_2 copia 0x20 x 8 de (0xE0, 0xC0) de la pagina 1 y el marco
L 0x777E puerta_tipo_3 ocho tiras de 1 x 0x20 en diagonal desde (0xE0, 0xA0)
L 0x77A7 puerta_tipo_4 ocho tiras de 1 x 0x20 en diagonal desde (0xE8, 0xA0)
L 0x77D8 puerta_tipo_1 copia 0x18 x 0x20 de (0xC4, 0xA0) de la pagina 1 y el marco
L 0x77F3 puerta_tipo_5 copia 0x18 x 0x20 de (0xC4, 0xC0) de la pagina 1 y el marco
L 0x784E puerta_dibujo copia el dibujo DE del banco 15 a 0xE600 y lo pone en 0xEC00
L 0x785B mira_las_puertas Snake ante una puerta que se abre: modo 7; en un paso abierto: modo 1 y 0xC4FC = la puerta
L 0x78E1 se_abre acarreo si la puerta HL se abre ahora, por su clase (bits 0-4, tabla 0x78F4)
L 0x7914 abre_clase_1 mirando a la derecha (o arriba si el byte es 5) y en el recuadro
L 0x794D abre_con_tarjeta con la tarjeta D elegida (0x0E-0x15 = CARD1-8), mirando hacia ella y en el recuadro
L 0x7960 abre_clase_10 mirando hacia ella, golpeando (estado 1) y en el recuadro
L 0x7973 abre_clase_11 una P.BOMB (proyectil 5) en marcha dentro, o golpe de 8 cuadros mirando hacia ella
L 0x79A7 abre_clase_12 en la sala 0x49 mirando abajo y en el recuadro; si no, con 0xC62C
L 0x79C9 abre_clase_13 con 0xC663 (lo pone el texto 0x76)
L 0x79D9 abre_clase_14 con 0xC610
L 0x79E9 abre_clase_15 golpeando mirando hacia ella: baja 0xC13F (o 0xC140 con la puerta 0x0C) hasta cero
L 0x7A18 abre_clase_16 una P.BOMB (proyectil 5) dentro, o golpe mirando hacia ella; con el sonido 0x0A
L 0x7A5E snake_en_recuadro acarreo si Snake esta en el recuadro de HL + 4 ([Y][alto][X][ancho])
L 0x7A62 snake_en_recuadro_hl acarreo si Snake esta en el recuadro de HL ([Y][alto][X][ancho])
L 0x7A7B proyectil_en_recuadro acarreo si el proyectil (0xC204, 0xC206) esta en el recuadro de HL
L 0x7A84 abre_puerta la puerta 0xC4FE se abre paso a paso (0xC4FD, tabla 0x7A8A)
L 0x7AB2 abre_puerta_0 paso 0: el sonido de la puerta (0x19 o 0x1B; 0x1E los tipos 7+) y el paso por su tipo
L 0x7AE9 abre_puerta_1 tipo 1: borra una linea de 0x20 cada cuadro hasta 0x18
L 0x7B06 abre_puerta_2 tipo 2: borra una linea de 8 cada cuadro
L 0x7B20 abre_puerta_3 tipo 3: borra 8 puntos en diagonal cada cuadro
L 0x7B48 abre_puerta_4 tipo 4: borra 8 puntos en la otra diagonal cada cuadro hasta 0x23
L 0x7B74 abre_puerta_5 tipo 5: borra dos lineas de 0x20 cada cuadro
L 0x7BD0 abre_dibujo tipos 7+: pone el dibujo abierto de 0xE600 (B x C fichas)
L 0x7BE4 puerta_abierta la puerta queda abierta: 0xC450 a cero, el marco y el modo 0
L 0x7C4A ficha_de_c4fe HL = la ficha de la puerta 0xC4FE en 0xC3D0
L 0x7C5C pantalla_al_empezar PSG, SCREEN 5, las dos paginas a cero, R#1/5/6/11 (0x7CA2) y los sprites
L 0x7CAA lee_teclas si se juega, las teclas de funcion en 0xC113/0xC112 y las del juego en 0xC007/0xC006
L 0x7CBC teclas_del_juego 0xC007 = las teclas que hay, 0xC006 = las nuevas
L 0x7CBF guarda_teclas (HL) = A y (HL - 1) = las que no estaban
L 0x7CC6 teclas A = palanca y cursores: 1 arriba, 2 abajo, 4 izquierda, 8 derecha, 0x10 espacio/boton 1, 0x20 M, N o boton 2
L 0x7D06 teclas_de_funcion A = F1 (1), F2 (2), F3 (4), F4 (8), F5 (0x10) y RETURN (0x20)
L 0x7D27 pon_c602_con_cuenta 0xC605 = A y pon_c602
L 0x7D2A pon_c602 0xC602 = 1, 0xC604 = la sala, 0xC606 y la musica 0x32 (0x2F si la pone un actor del tipo 6 o 0x23)
L 0x7D7F secuencia_c900 la secuencia de 6 pasos de 0xC900 (tabla 0x7D85)
L 0x7D91 c900_paso_0 crea un actor del tipo 0x2D en la Y de Snake, X = 0xF0
L 0x7DA0 c900_paso_2 espera de 0x3C cuadros y la musica 0x5C
L 0x7DAF c900_paso_3 al acabar la espera, guarda la paleta
L 0x7DB9 c900_paso_4 funde la paleta hasta negro
L 0x7DC5 c900_paso_5 0xC13B = 1, sin arma ni objeto, sala 0xA5, parada 8, Snake en (0x50, 0x80)
L 0x7E01 crea_tipo_45 la creacion del tipo 45
L 0x7E0E cuadro_tipo_45 lo de cada cuadro del tipo 45
