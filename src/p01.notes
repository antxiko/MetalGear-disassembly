C 0x7AF2 ...hasta 0x18
C 0x7AF7 +5, +6: la Y y la X
C 0x7AFC la linea: X + cuenta
C 0x7AFF 0x20 de alto en negro
C 0x7B09 +4: la cuenta
C 0x7B0D una menos
C 0x7B12 la X: X + cuenta - 1
C 0x7B19 8 de alto en negro
C 0x7B23 +4: la cuenta
C 0x7B27 una menos
C 0x7B2B la Y: Y + cuenta
C 0x7B33 8 puntos en diagonal
C 0x7B35 un punto negro
C 0x7B3E 4 lineas mas abajo...
C 0x7B43 ...y uno a la derecha
C 0x7B4B +4: la cuenta
C 0x7B4F una mas...
C 0x7B51 ...hasta 0x23
C 0x7B5A la Y: Y + cuenta + 0x1C
C 0x7B5F 8 puntos en la otra diagonal
C 0x7B61 un punto negro
C 0x7B6A 4 lineas mas arriba...
C 0x7B6F ...y uno a la derecha
C 0x7B77 +4: la cuenta
C 0x7B7B una menos
C 0x7B7F la X: X + cuenta - 1
C 0x7B87 0x20 de alto en negro
C 0x7B8E la otra mitad, al otro lado
C 0x7B9D 0x20 de alto en negro
C 0x7BA5 tipo 7: 4 x 6 fichas
C 0x7BAA tipo 8: 4 x 1
C 0x7BAF tipos 9 y 15: 3 x 0x0D
C 0x7BB4 tipo 10: 5 x 0x0D
C 0x7BB9 tipos 11 y 19: 5 x 0x0C
C 0x7BBE tipo 14: 4 x 1
C 0x7BC3 tipos 16 y 18: 2 x 0x0C
C 0x7BC8 tipo 17: 8 x 0x0A
C 0x7BCD tipo 20: 6 x 5
C 0x7BD3 +5: la Y y la X
C 0x7BDF el dibujo de la puerta abierta (0xE600) en su sitio
C 0x7BE4 +4 a cero
C 0x7BE7 C = +3, el tipo
C 0x7BE9 A = +2, la clase
C 0x7BEB +1 (el estado) a cero: abierta
C 0x7BEE las clases con los bits 7-6 no se apuntan
C 0x7BF2 +0: el numero de puerta...
C 0x7BFA ...queda abierta en 0xC450
C 0x7BFC los tipos 7, 10 y 11...
C 0x7C0B ...pierden el numero (+0 a cero)
C 0x7C0D +5: la Y y la X
C 0x7C15 el tipo 3, 8 puntos a la izquierda
C 0x7C1E el modo 0
C 0x7C23 del 7 en adelante, nada mas
C 0x7C26 el marco abierto por el tipo: 1 y 5, 4 x 4...
C 0x7C2C ...2, 4 x 1...
C 0x7C32 ...3 y 4, 2 x 4 0x20 mas abajo
C 0x7C44 las fichas del marco abierto (p15:A710)
C 0x7C50 la ficha de la puerta: 0xC3D0 + 0x10 x numero
C 0x7C5C R#7 del PSG: sin sonido (y su copia en 0xC0F0)
C 0x7C6A SCREEN 5
C 0x7C75 la pagina 1 tambien
C 0x7C7D 4 registros del VDP de 0x7CA2: R#1, R#5, R#6 y R#11
C 0x7C82 [registro][valor]
C 0x7C8F 0xF880-0xF91F (patrones 0x10-0x23) a cero
C 0x7CAD solo si se juega
C 0x7CBF C = las que habia
C 0x7CC0 las que hay ahora
C 0x7CC1 las que cambiaron...
C 0x7CC2 ...y estan pulsadas: las nuevas
C 0x7CC6 R#15 del PSG = 0x8F: la palanca del puerto 1
C 0x7CCD R#14: los botones de la palanca
C 0x7CD4 pulsado = 1
C 0x7CD5 arriba, abajo, izquierda, derecha, botones 1 y 2
C 0x7CD8 la fila 4 del teclado
C 0x7CDD el bit 2 (M)...
C 0x7CE4 ...o el 3 (N): 0x20
C 0x7CE9 la fila 8: cursores y espacio
C 0x7CEE pulsado = 1
C 0x7CF2 el bit 4 (izquierda) a 4
C 0x7CFA el 7 (derecha) a 8 y el 0 (espacio) a 0x10
C 0x7CFF el 5 (arriba) a 1 y el 6 (abajo) a 2
C 0x7D03 con la palanca
C 0x7D06 la fila 6: F1, F2 y F3 en los bits 5-7
C 0x7D0C a los bits 0-2
C 0x7D12 la fila 7: F4 y F5 en los bits 0-1, RETURN en el 7
C 0x7D19 F4 y F5 a los bits 3-4
C 0x7D20 RETURN al bit 5
C 0x7D2A la bandera puesta
C 0x7D2F tambien en 0xC632
C 0x7D35 0xC604 = la sala
C 0x7D38 en la sala 0xD8, 0xC606 = 0
C 0x7D3E si no, el ultimo bit 0 puesto de 0xC5AD-0xC5B4...
C 0x7D4A ...+ 3: cuantos refuerzos
C 0x7D53 con la cuenta atras, sin musica nueva
C 0x7D55 con el sonido 0x44 sonando, tampoco
C 0x7D5B la camara (6) y el tipo 0x23: la musica 0x2F
C 0x7D66 los demas: la 0x32
C 0x7D6F en la demo, solo con 0xF0F7
C 0x7D94 el paso siguiente
C 0x7D95 el tipo 0x2D...
C 0x7D9A ...en la Y de Snake...
C 0x7D9B ...y en X = 0xF0
C 0x7DA3 el paso siguiente
C 0x7DA7 0x3C cuadros
C 0x7DA9 la musica 0x5C tras el fundido
C 0x7DB3 al acabar...
C 0x7DB5 ...el paso siguiente
C 0x7DBC hasta que este todo negro
C 0x7DC2 0x10 cuadros
C 0x7DC9 al acabar:
C 0x7DCD capturado
C 0x7DDF la sala 0xA5
C 0x7DE4 la parada 8
C 0x7DE9 Y = 0x50
C 0x7DEE X = 0x80
C 0x7DFC el modo 0
C 0x7E01 el cuadro 0x0A
C 0x7E05 no choca con nada
C 0x7E09 2 cuadros
C 0x7E0E por el paso (tabla 0x7E14)
C 0x7E22 espera...
C 0x7E26 ...y el paso siguiente
C 0x7E2A el paso 6
C 0x7E2E el sonido 6
C 0x7E33 otro tipo 0x2D...
C 0x7E38 ...en Y = 0xB0 o 0x88 segun la Y de Snake
C 0x7E40 X = 0xF0
C 0x7E47 el nuevo...
C 0x7E4A ...en el paso 2, moviendose, hacia la izquierda
C 0x7E66 al llegar a X = 0xB8...
C 0x7E69 ...el paso siguiente
C 0x7E6F hacia arriba o abajo segun la Y
C 0x7E83 al llegar a la Y de Snake...
C 0x7E89 ...se para
C 0x7E90 el cuadro 0x0B
C 0x7E99 espera...
C 0x7EA0 ...0x1E cuadros
C 0x7EA4 el sonido 7
C 0x7EA9 espera...
C 0x7EB3 ...y el paso siguiente de 0xC900
C 0x7EB8 F3: cierra la ventana
C 0x7EC0 paso 1: elegir
C 0x7ED3 paso 0: la pantalla de equipo
C 0x7EDD 25 huecos
C 0x7EF4 la tecla 0x10: usar el objeto
C 0x7EF9 una tecla de direccion nueva...
C 0x7F00 ...o mantenida cada 8 cuadros
C 0x7F08 8 cuadros hasta repetir
C 0x7F0D arriba
C 0x7F10 abajo
C 0x7F13 izquierda
C 0x7F19 derecha: 9 huecos mas alla (salvo la ultima columna)
C 0x7F21 arriba: uno menos (no desde 1, 0x0A ni 0x13)
C 0x7F31 abajo: uno mas (no desde 9, 0x12 ni 0x19)
C 0x7F41 izquierda: 9 huecos menos
C 0x7F4A el sonido 0x20
C 0x7F5F capturado: sin objeto
C 0x7F65 el objeto del hueco
C 0x7F79 sin objeto, nada
C 0x7F81 GOGGL: nada
C 0x7F85 RATIO (0x16): se gasta una...
C 0x7F8A ...y la vida al maximo
C 0x7F9B el objeto 0x17: se gasta...
C 0x7FA5 ...y 0xC5B6 a cero
C 0x7FAB ANTID (0x0D): fuera el veneno
C 0x7FB5 CIGAL (6):
C 0x7FBD se gasta uno...
C 0x7FC3 ...y 0xC13E sube 0x20 (BCD)
C 0x7FCE el sonido 0x21
C 0x7FDD SCOPE (9):
C 0x7FE2 el modo 8 (telescopio)
C 0x7FE7 paso 0, vuelta 1
C 0x7FF5 los actores a 0xD800

